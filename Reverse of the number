import java.util.Scanner;

class Main {
    public static void main(String[] args) {
       Scanner in=new Scanner(System.in);
       System.out.println("enter n");
       int n=in.nextInt();
       int rev=0;
       while(n!=0)
       {
        int digits=n%10;
        rev=rev*10+digits;
        n=n/10;

       }
       System.out.println("reverse of the digits"+rev);
       }}
